NEXT_PUBLIC_SITE_URL=https://www.contractlossexpert.com

# n8n lead webhook — required for contact form notifications
# Set in Netlify → Site configuration → Environment variables
Lead_notification_url=
# LEAD_NOTIFICATION_URL=

# Google Sheets (optional — one shared tab + Form Type; soft-fail after webhook)
# For local dev, copy to .env.local
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Sheet1

# Analytics & verification (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_HOTJAR_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
